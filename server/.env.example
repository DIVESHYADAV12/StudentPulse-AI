# Server Configuration
PORT=8005
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Configuration (Update with your free MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/studentpulse?retryWrites=true&w=majority
MONGODB_DB_NAME=studentpulse

# Authentication (JWT)
JWT_SECRET=dev-secret-key-studentpulse-ai-super-secure-token-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration - Google Gemini (Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq AI Configuration (Ultra-Fast Llama 3.3 for Interview Prep & Mentor)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
