# Server Configuration
PORT=8005
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Configuration (MongoDB Atlas Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/studentpulse?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/studentpulse?retryWrites=true&w=majority
MONGODB_DB_NAME=studentpulse

# Authentication (JWT)
JWT_SECRET=generate_a_random_32_character_secret_here_for_security
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration (Google Gemini Free Tier)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
